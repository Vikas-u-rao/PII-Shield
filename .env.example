# ==============================================================================
# PIIShield - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://piishield_user:piishield_password@localhost:5432/piishield_db

# Security & Cryptography (Generate secure random values for production)
JWT_SECRET=change-this-to-a-secure-random-jwt-secret-in-production
JWT_ALGORITHM=HS256
PSEUDONYM_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-placeholder

# Session & TTL Management
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
SESSION_HARD_CAP_SECONDS=86400

# External LLM Integration
LLM_PROVIDER=openai_mock
LLM_API_KEY=mock-llm-api-key-placeholder
LLM_BASE_URL=https://api.openai.com/v1

# ChromaDB Disambiguation (Offline synthetic exemplar store)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=pii_exemplars
